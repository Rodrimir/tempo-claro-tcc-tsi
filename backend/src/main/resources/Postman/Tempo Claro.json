    {
      "name": "04 - Execuções",
      "item": [
        {
          "name": "Execute Habit — Sucesso (Completar)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gera um UUID v4 aleatório para o execution_token",
                  "function uuidv4() {",
                  "    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                  "        return v.toString(16);",
                  "    });",
                  "}",
                  "pm.environment.set('execution_token', uuidv4());",
                  "console.log('execution_token gerado:', pm.environment.get('execution_token'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Retorna moedas ganhas', function() {",
                  "    pm.expect(jsonData).to.have.property('moedas_ganhas');",
                  "});",
                  "",
                  "console.log('Moedas ganhas:', jsonData.moedas_ganhas);",
                  "console.log('Moedas totais:', jsonData.moedas_totais);",
                  "console.log('Dias seguidos:', jsonData.dias_seguidos);",
                  "console.log('Feedback:', jsonData.texto_feedback);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"execution_token\": \"{{execution_token}}\",\n  \"tipo\": \"sucesso\",\n  \"valor_realizado\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/habits/{{habit_id}}/executions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "habits",
                "{{habit_id}}",
                "executions"
              ]
            },
            "description": "Registra a execução BEM-SUCEDIDA de um hábito.\n\nCampos obrigatórios:\n- execution_token: UUID único por sessão de execução (gerado automaticamente pelo script)\n- tipo: 'sucesso' para completar o hábito\n- valor_realizado: quantidade realizada (para binário: 1, para quantitativo: a quantidade)\n\nRetorna:\n- moedas_ganhas: moedas ganhas nessa execução\n- moedas_totais: total acumulado\n- dias_seguidos: streak atual\n- novo_nivel: nível atingido (se subiu)\n- texto_feedback: mensagem motivacional\n\nNOTA: O execution_token é gerado automaticamente pelo Pre-request Script."
          },
          "response": []
        },

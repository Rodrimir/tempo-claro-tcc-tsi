    {
      "name": "05 - Estatísticas",
      "item": [
        {
          "name": "Estatísticas do mês",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats/monthly?habitoId={{habitoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats",
                "monthly"
              ],
              "query": [
                {

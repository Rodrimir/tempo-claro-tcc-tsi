              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Autentica um usuário existente e retorna um JWT.\n\nCampos obrigatórios:\n- email: email cadastrado\n- password: senha correspondente\n\nRetorna um token JWT que é salvo automaticamente em {{token}}.\n\nErros comuns:\n- 401 Unauthorized: email ou senha incorretos\n- 400 Bad Request: campos inválidos ou ausentes"

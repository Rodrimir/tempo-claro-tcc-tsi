# Artefatos de build
/backend/target/
/backend/bin/
/tcc
# Dependências e builds do app. O projeto Android é gerado pelo `expo prebuild`
# a cada build e não é versionado (o frontend/.gitignore também o exclui).
node_modules/
/frontend/.expo/
/frontend/android/
/frontend/dist/
# APKs gerados para teste, deixados na raiz
/*.apk
/docs
/.vscode
/.idea
/.claude
/auditoria
# Configurações de execução do IntelliJ e arquivos de sistema
/backend/.run/
.DS_Store
Thumbs.db
*.log
*.bak
# Anotações locais com contas e senhas de teste
/frontend/teste.txt
# Variáveis de ambiente — jwt.secret e as credenciais do banco vêm daqui em prod
.env
.env.local
*.env

# Relatório de auditoria: material de trabalho local, fora do repositório.
/RELATORIO_AUDITORIA.md

# Configuração local do Spring (credenciais de SMTP etc.) — o Spring lê
# ./config/application.properties automaticamente, com precedência sobre o
# application.properties do classpath. Nunca versionar.
/backend/config/
